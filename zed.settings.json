// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    // ── Appearance ─────────────────────────────────────────────────────────────
    "ensure_final_newline_on_save": true,
    "buffer_font_family": "JetBrains Mono",
    "agent_servers": {
        "claude-acp": {
            "type": "registry",
        },
    },
    "ui_font_family": "JetBrains Mono",
    "ui_font_size": 16,
    "buffer_font_size": 15,
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "GitHub Dark Dimmed",
    },
    "icon_theme": "Material Icon Theme",

    // ── Editor ─────────────────────────────────────────────────────────────────
    "preferred_line_length": 120,
    "soft_wrap": "none",
    "tab_size": 4,
    "hard_tabs": false,
    "cursor_blink": false,
    "relative_line_numbers": "disabled", // JetBrains uses absolute line numbers
    "use_autoclose": true,
    "use_auto_surround": true,
    "show_completions_on_input": true,
    "show_completion_documentation": true,
    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },
    "languages": {
        "YAML": {
            "tab_size": 2,
        },
    },

    // ── Inlay hints (JetBrains signature) ──────────────────────────────────────
    "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true,
    },

    // ── Gutter (line numbers + VCS markers + fold controls) ────────────────────
    "gutter": {
        "breakpoints": true,
        "line_numbers": true,
        "folds": true,
        "runnables": true,
    },

    // ── Indent guides ──────────────────────────────────────────────────────────
    "indent_guides": {
        "enabled": true,
        "line_width": 1,
        "active_line_width": 2,
        "coloring": "indent_aware",
    },

    // ── Scrollbar with diagnostics/search/VCS markers ──────────────────────────
    "scrollbar": {
        "show": "always",
        "cursors": true,
        "git_diff": true,
        "search_results": true,
        "selected_symbol": true,
        "diagnostics": "all",
    },

    // ── Toolbar (breadcrumbs = JetBrains navigation bar) ───────────────────────
    "toolbar": {
        "breadcrumbs": true,
        "quick_actions": true,
    },

    // ── Tab bar ────────────────────────────────────────────────────────────────
    "tab_bar": {
        "show": true,
        "show_nav_history_buttons": true,
    },

    // ── Minimap ────────────────────────────────────────────────────────────────
    "minimap": {
        "show": "always",
    },

    // ── Git ────────────────────────────────────────────────────────────────────
    "git": {
        "git_gutter": "tracked_files",
        "inline_blame": {
            "enabled": true,
            "delay_ms": 600,
        },
    },

    // ── Panels ─────────────────────────────────────────────────────────────────
    "project_panel": {
        "dock": "left",
        "auto_fold_dirs": true,
        "git_status": true,
        "auto_reveal_entries": true,
    },
    "outline_panel": {
        "dock": "right",
    },
    "terminal": {
        "dock": "bottom",
    },

    // ── Keymaps & modes ────────────────────────────────────────────────────────
    "vim_mode": true,
    "base_keymap": "JetBrains",

    // ── Telemetry ──────────────────────────────────────────────────────────────
    "telemetry": {
        "diagnostics": true,
        "metrics": false,
    },
}
